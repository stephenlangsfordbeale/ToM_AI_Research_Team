#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/tom_paths.sh
source "$script_dir/scripts/tom_paths.sh"

usage() {
  cat <<EOF
Test Mode — local runner + promotion gate (baseline vs candidate).

Usage:
  $(basename "$0") [--train-episodes N] [--seed N] [--output-root PATH]

Defaults:
  train-episodes: 5   (smoke; use 800 for a scientific gate)
  seed:           7
  output-root:    logs/test-run-<timestamp>

Examples:
  $(basename "$0")
  $(basename "$0") --train-episodes 800 --seed 7 --output-root logs/demo-gate
EOF
}

train_episodes=5
seed=7
stamp="$(date +%Y%m%d-%H%M%S)"
output_root="$TOM_REPO_ROOT/logs/test-run-$stamp"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --train-episodes)
      train_episodes="${2:-}"
      shift 2
      ;;
    --seed)
      seed="${2:-}"
      shift 2
      ;;
    --output-root)
      output_root="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ ! -f "$TOM_REPO_ROOT/scripts/local_runner.py" ]]; then
  echo "local_runner.py not found under $TOM_REPO_ROOT" >&2
  exit 1
fi

python_bin="${TOM_PYTHON:-python3}"
if [[ -x "$TOM_REPO_ROOT/.venv/bin/python" ]]; then
  python_bin="$TOM_REPO_ROOT/.venv/bin/python"
fi

echo "Test Mode"
echo "  repo:            $TOM_REPO_ROOT"
echo "  train-episodes:  $train_episodes"
echo "  seed:            $seed"
echo "  output-root:     $output_root"
echo

cd "$TOM_REPO_ROOT"
"$python_bin" scripts/local_runner.py \
  --train-episodes "$train_episodes" \
  --seed "$seed" \
  --output-root "$output_root"

selection_file="$output_root/selection/selection.json"
echo
echo "----- selection -----"
if [[ -f "$selection_file" ]]; then
  "$python_bin" - "$selection_file" <<'PY'
import json, sys
path = sys.argv[1]
obj = json.load(open(path, encoding="utf-8"))
print(f"decision={obj.get('decision', 'n/a')}")
print(f"selected_variant={obj.get('selected_variant', 'n/a')}")
baseline = obj.get("baseline_metrics") or {}
candidate = obj.get("candidate_metrics") or {}
if isinstance(baseline, dict):
    print(f"baseline ToMCoordScore={baseline.get('ToMCoordScore', 'n/a')}")
if isinstance(candidate, dict):
    print(f"candidate ToMCoordScore={candidate.get('ToMCoordScore', 'n/a')}")
print(f"artifact={path}")
PY
else
  echo "selection.json missing: $selection_file" >&2
  exit 1
fi

echo
echo "Packaged artifacts under: $output_root"
